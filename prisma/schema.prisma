generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id         Int      @id @default(autoincrement())
  judul      String
  deskripsi  String   @default("Tidak ada catatan tambahan.")
  mataKuliah String
  kategori   String   @default("Individu")
  prioritas  String   @default("Medium")
  tenggat    String
  jam        String   @default("23:59")
  status     String   @default("Pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}